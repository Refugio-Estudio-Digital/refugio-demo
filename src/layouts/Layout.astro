---
import '@/styles/global.css';
import { Font } from 'astro:assets';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-montserrat" preload />
		<Font cssVariable="--font-lora" preload />
		<title>Refugio | Tu Casa Digital en la Montaña</title>

		<meta
			name="description"
			content="Eliminamos la fricción digital de tu café. Menús instantáneos, visibilidad real en Google Maps y autonomía total. Un refugio técnico para negocios que no se detienen."
		/>

		<meta property="og:title" content="Refugio | Estudio Digital" />
		<meta
			property="og:description"
			content="¿Cansado de que tu menú cargue lento? Mirá cómo transformamos la presencia digital de tu cafetería."
		/>
		<meta property="og:type" content="website" />
	</head>
	<body>
		<slot />
	</body>
</html>
