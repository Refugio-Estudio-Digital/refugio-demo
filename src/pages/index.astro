---
import Layout from '@/layouts/Layout.astro';

const cafeteriaItems = [
	{
		name: 'Espresso Doble',
		description: 'Café de altura, intenso y aromático',
		price: '$3.50',
	},
	{
		name: 'Cappuccino Alpino',
		description: 'Espresso con leche vaporizada',
		price: '$4.20',
	},
	{
		name: 'Latte de Vainilla',
		description: 'Café suave con esencia de vainilla',
		price: '$4.80',
	},
	{
		name: 'Chocolate Caliente',
		description: 'Cacao artesanal con canela',
		price: '$4.50',
	},
];

const pasteleriaItems = [
	{
		name: 'Croissant de Mantequilla',
		description: 'Hojaldre dorado y crujiente',
		price: '$3.80',
	},
	{
		name: 'Tarta de Manzana',
		description: 'Manzanas caramelizadas',
		price: '$5.50',
	},
	{
		name: 'Brownie de Nuez',
		description: 'Chocolate intenso con nueces',
		price: '$4.20',
	},
	{
		name: 'Cheesecake Clásico',
		description: 'Cremoso queso con frutos rojos',
		price: '$6.00',
	},
];

const whatsappUrl = `https://wa.me/5492944212964?text=${encodeURIComponent('¡Hola! Me gustaría hacer un pedido.')}`;
---

<Layout>
	<div class="min-h-screen bg-background">
		{/* Speed Banner */}
		<div class="bg-accent px-4 py-4 text-center">
			<p class="text-sm font-medium text-accent-foreground md:text-base">
    <span class="font-semibold">
      Este menú cargó en <span id="load-time">0.0</span> segundos
    </span>
    <span class="mx-2 opacity-60">·</span>
    <span class="opacity-80">un menú PDF tarda 7 segundos</span>
  </p>
		</div>

		<main class="mx-auto max-w-2xl px-6 py-12 md:py-16">
			{/* Header */}
			<header class="mb-16 text-center">
				<p class="mb-3 text-xs uppercase tracking-widest text-muted-foreground">
					Menú Digital Demo
				</p>
				<h1
					class="text-4xl font-semibold tracking-tight text-foreground md:text-5xl"
				>
					Refugio de Montaña
				</h1>
				<p class="mt-4 text-base text-muted-foreground">
					La elegancia es claridad
				</p>
			</header>

			{/* Cafetería Section */}
			<section class="mb-16">
				<div class="mb-6 flex items-center gap-4">
					<h2 class="text-2xl font-semibold text-foreground md:text-3xl">
						Cafetería
					</h2>
					<div class="h-px flex-1 bg-border/50"></div>
				</div>
				<div class="grid gap-4">
					{
						cafeteriaItems.map((item) => (
							<article class="rounded-lg border border-primary/30 bg-card/50 p-4 transition-colors hover:border-primary/60 hover:bg-card/80">
								<div class="flex items-start justify-between gap-4">
									<div class="flex-1">
										<h3 class="text-lg font-medium text-foreground">
											{item.name}
										</h3>
										<p class="mt-1 text-sm text-muted-foreground">
											{item.description}
										</p>
									</div>
									<span class="shrink-0 text-lg font-semibold text-accent">
										{item.price}
									</span>
								</div>
							</article>
						))
					}
				</div>
			</section>

			{/* Pastelería Section */}
			<section class="mb-16">
				<div class="mb-6 flex items-center gap-4">
					<h2 class="text-2xl font-semibold text-foreground md:text-3xl">
						Pastelería
					</h2>
					<div class="h-px flex-1 bg-border/50"></div>
				</div>
				<div class="grid gap-4">
					{
						pasteleriaItems.map((item) => (
							<article class="rounded-lg border border-primary/30 bg-card/50 p-4 transition-colors hover:border-primary/60 hover:bg-card/80">
								<div class="flex items-start justify-between gap-4">
									<div class="flex-1">
										<h3 class="text-lg font-medium text-foreground">
											{item.name}
										</h3>
										<p class="mt-1 text-sm text-muted-foreground">
											{item.description}
										</p>
									</div>
									<span class="shrink-0 text-lg font-semibold text-accent">
										{item.price}
									</span>
								</div>
							</article>
						))
					}
				</div>
			</section>

			{/* Footer */}
			<footer class="border-t border-border/30 pt-8 text-center">
				<p class="text-xs text-muted-foreground">
					Horario: 8:00 – 20:00 · Todos los días
				</p>
				<p class="mt-2 text-xs text-muted-foreground/60">
					Precios incluyen impuestos
				</p>
			</footer>
		</main>

		{/* WhatsApp Button */}
		<a
			href={whatsappUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="fixed bottom-6 right-6 z-50 flex items-center gap-3 rounded-full bg-accent px-6 py-4 text-sm font-semibold text-accent-foreground shadow-lg transition-transform hover:scale-105 md:bottom-8 md:right-8"
			aria-label="Pedir por WhatsApp"
		>
			<svg
				class="h-5 w-5"
				fill="currentColor"
				viewBox="0 0 24 24"
				aria-hidden="true"
			>
				<path
					d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
				></path>
			</svg>
			<span>Pedir por WhatsApp</span>
		</a>
	</div>
	<script>
		window.addEventListener('load', () => {
			const timeInMs = performance.now();
			const timeInSeconds = (timeInMs / 1000).toFixed(2);

			const display = document.getElementById('load-time');
			if (display) {
				display.textContent = timeInSeconds;
			}
		});
	</script>
</Layout>
